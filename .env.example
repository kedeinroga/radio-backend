# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_ENV=development
SERVER_TIMEOUT=30s

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/radio_backend?sslmode=disable
DATABASE_MAX_CONNECTIONS=25
DATABASE_MAX_IDLE_CONNECTIONS=5

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem

# External APIs
RADIO_BROWSER_API_URL=https://de1.api.radio-browser.info

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Analytics
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=10s

# Security
BCRYPT_COST=12
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Language,X-Request-ID

# Feature Flags
FEATURE_PREMIUM_CONTENT=true
FEATURE_ANALYTICS=true
FEATURE_VAULT_INTEGRATION=false

# HashiCorp Vault (Optional)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/radio-backend

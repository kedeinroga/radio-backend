# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_ENV=development
SERVER_TIMEOUT=30s
SERVER_BASE_URL=http://localhost:8080  # Base URL for SEO canonical links (change in production)

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/radio_backend?sslmode=disable
DATABASE_MAX_CONNECTIONS=25
DATABASE_MAX_IDLE_CONNECTIONS=5

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem

# External APIs
RADIO_BROWSER_API_URL=https://de1.api.radio-browser.info

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Analytics
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=10s

# Security
BCRYPT_COST=12
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# CORS
# SECURITY: NEVER use "*" in production! Specify exact origins.
# Development example:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Production example:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Language,X-Request-ID

# Cache
CACHE_STATION_MAX_AGE=168h  # 7 days
CACHE_SEARCH_TTL=1h
CACHE_SYNC_INTERVAL=1h
CACHE_SYNC_BATCH_SIZE=100
CACHE_CLEANUP_INTERVAL=24h
CACHE_INACTIVE_THRESHOLD=720h  # 30 days

# Feature Flags
FEATURE_PREMIUM_CONTENT=true
FEATURE_ANALYTICS=true
FEATURE_VAULT_INTEGRATION=false

# HashiCorp Vault (Optional)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/radio-backend
